# 개발용 환경변수 템플릿
# 실제 값은 .env 에 (Git 제외)
# Vite에서 읽으려면 반드시 VITE_ 접두사 필요

# 예시: 외부 서비스 API 키
# VITE_ANALYTICS_KEY=

# 백엔드 base URL
# 비워두면 Vite proxy가 /api/v1 -> http://localhost:8080 으로 보냄
# 직접 CORS를 검증하거나 백엔드 포트를 바꿔 띄울 때만 지정
# VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Standard axios client controls
# VITE_API_TIMEOUT_MS=15000
# VITE_API_RETRY_ATTEMPTS=0
# VITE_API_RETRY_DELAY_MS=150

# React Query Devtools floating panel
# VITE_REACT_QUERY_DEVTOOLS=true

# 사이트의 공개 주소 — canonical · og:url · sitemap.xml 의 바탕(없으면 그 태그를 빼고 sitemap.xml 도 만들지 않는다)
# VITE_SITE_URL=https://notes.example.com
