# 개발용 환경변수 템플릿 (서버 렌더 앱)
# 실제 값은 .env 에 (Git 제외)

# --- Node 서버(server/config.ts) — 일반 환경변수. 브라우저로 나가지 않는다 ---
# 듣는 주소 · 포트(기본 127.0.0.1:3000, 컨테이너는 HOST=0.0.0.0, PORT=0 이면 빈 포트)
# HOST=127.0.0.1
# PORT=3000
# 서버 렌더가 첫 데이터를 가져오는 백엔드(절대 주소 — 서버에는 origin 이 없다)
# API_BASE_URL=http://localhost:8080/api/v1
# 서버 렌더 중 백엔드를 기다리는 최대 시간(ms). 넘으면 데이터 없이 그린다(브라우저가 다시 부른다)
# SSR_API_TIMEOUT_MS=2000
# vite build 결과 폴더(기본 ./dist)
# DIST_DIR=./dist
# 사이트의 공개 주소 — canonical · og:url · sitemap.xml 의 바탕(없으면 그 태그를 빼고 추측하지 않는다). 빌드(sitemap.xml)에도 필요하다
# SITE_URL=https://example.com

# --- 브라우저(Vite) — VITE_ 접두사가 있어야 브라우저 코드에서 읽힌다 ---
# 비워두면 같은 origin 의 /api/v1 (개발: Vite proxy → :8080, 프로덕션: Caddy 가 백엔드로)
# VITE_API_BASE_URL=
# VITE_API_TIMEOUT_MS=15000
# VITE_API_RETRY_ATTEMPTS=0
# VITE_API_RETRY_DELAY_MS=150

# 로그인 — 방법(비밀번호 · 링크 · 소셜)은 백엔드가 알려 준다(GET /auth/methods). 아래는 선택적 덮어쓰기
# 방법을 이 목록으로 고정(백엔드에 묻지 않는다): password · magic-link · 소셜 제공자 코드
# VITE_AUTH_METHODS=password,magic-link
# 백엔드가 clientId 를 모르는 소셜 제공자에 앱이 주는 공개 값
# VITE_SOCIAL_GOOGLE_CLIENT_ID=
# 토큰 전달 방식 — body(기본, localStorage) | cookie(HttpOnly 쿠키). 백엔드 skeleton.auth-session.delivery 와 같아야 한다
# VITE_AUTH_REFRESH_DELIVERY=cookie
