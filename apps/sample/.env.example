# 개발용 환경변수 템플릿
# 실제 값은 .env 에 (Git 제외)
# Vite에서 읽으려면 반드시 VITE_ 접두사 필요

# 예시: 외부 서비스 API 키
# VITE_ANALYTICS_KEY=

# 백엔드 base URL
# 비워두면 Vite proxy가 /api/v1 -> http://localhost:8080 으로 보냄
# 직접 CORS를 검증하거나 백엔드 포트를 바꿔 띄울 때만 지정
# VITE_API_BASE_URL=
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Standard axios client controls
# VITE_API_TIMEOUT_MS=15000
# VITE_API_RETRY_ATTEMPTS=0
# VITE_API_RETRY_DELAY_MS=150

# React Query Devtools floating panel
# VITE_REACT_QUERY_DEVTOOLS=true

# 방문 통계 - 관리자 대시보드가 읽는다. 둘 다 비우면 아무것도 붙지 않는다
# GA4 측정 ID(G-XXXX): 쿠키 동의 배너에서 「analytics」에 동의한 방문자에게만 gtag 를 붙인다
# VITE_GA_MEASUREMENT_ID=
# Cloudflare Web Analytics 비콘 토큰(쿠키 없음, 동의와 무관하게 붙는다. 프록시 켠 도메인은 Cloudflare 가 자동으로 넣기도 한다)
# VITE_CF_BEACON_TOKEN=

# 사이트의 공개 주소 — canonical · og:url · sitemap.xml 의 바탕(없으면 그 태그를 빼고 sitemap.xml 도 만들지 않는다)
# VITE_SITE_URL=https://notes.example.com

# 로그인 — 방법(비밀번호 · 링크 · 소셜)은 백엔드가 알려 준다(GET /auth/methods). 아래는 선택적 덮어쓰기
# 방법을 이 목록으로 고정(백엔드에 묻지 않는다): password · magic-link · 소셜 제공자 코드
# VITE_AUTH_METHODS=password,magic-link
# 백엔드가 clientId 를 모르는 소셜 제공자에 앱이 주는 공개 값
# VITE_SOCIAL_GOOGLE_CLIENT_ID=
# 토큰 전달 방식 — body(기본, localStorage) | cookie(HttpOnly 쿠키). 백엔드 skeleton.auth-session.delivery 와 같아야 한다
# VITE_AUTH_REFRESH_DELIVERY=cookie

# 결제사는 서버가 접속 나라로 정한다(한국 → 토스, 그 밖 → Paddle) - 화면 설정이 없다. 로컬에서 나라를 바꾸려면 백엔드의 SKELETON_PAYMENT_ROUTING_DEV_COUNTRY=US
