    "@skeleton/time": "workspace:*",
    "@skeleton/tokens": "workspace:*",
    "@skeleton/ui": "workspace:*",
    "@tanstack/react-query": "^5.99.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "sonner": "^2.0.7"
  },
