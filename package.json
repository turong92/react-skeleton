{
  "name": "react-skeleton",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter starter dev",
    "dev:workbench": "pnpm --filter workbench dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test && vitest run --pool forks --config vitest.root.config.ts && bash scripts/test-new-project.sh --quick",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "tokens": "pnpm --filter @skeleton/tokens tokens",
    "tokens:check": "pnpm --filter @skeleton/tokens tokens:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@skeleton/theme": "workspace:*",
    "@skeleton/tokens": "workspace:*",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.8"
  }
}
