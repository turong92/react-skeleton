{
  "name": "starter-ssr",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/main.ts --dev",
    "build": "tsc -b && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "node server/main.ts",
    "test": "vitest run --pool forks",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@skeleton/api-client": "workspace:*",
    "@skeleton/auth": "workspace:*",
    "@skeleton/theme": "workspace:*",
    "@skeleton/time": "workspace:*",
    "@skeleton/tokens": "workspace:*",
    "@skeleton/ui": "workspace:*",
    "@tanstack/react-query": "^5.99.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "sonner": "^2.0.7"
  }
}
